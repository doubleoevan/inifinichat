# Copy this file to .env. Uncomment the settings you use and fill in their values there.

# OpenAI API key for scheduling chat.
# OPENAI_API_KEY=

# Pooled Neon connection string for the running app.
# DATABASE_URL=

# Direct Neon connection string for migrations and seeding. The seed falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Neon branch name and ID.
# NEON_BRANCH=
# NEON_BRANCH_ID=

# Hostname suffix for Neon Functions.
# NEON_FUNCTION_HOST_SUFFIX=

#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"

# The checker reads the worktree. Every input must match the staged snapshot.
set -- src tsconfig.json .dependency-cruiser.json package.json bun.lock .githooks/pre-commit
if ! git diff --quiet -- "$@" || [ -n "$(git ls-files --others --exclude-standard -- "$@")" ]; then
  echo "Module boundary inputs have unstaged changes. Stage or set aside those edits first." >&2
  exit 1
fi
exec bun run boundaries

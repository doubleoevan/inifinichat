#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"

# Check the exact files Git would publish, including a force-added .env.
if [ -n "$(git ls-files --cached -- .env ':(glob)**/.env' ':(glob)**/.env.local' ':(exclude,top).env.local')" ]; then
  echo "Keep real environment files out of Git." >&2
  exit 1
fi
git cat-file -e :.env.local || { echo "The public environment reference is required." >&2; exit 1; }
if ! git show :.env.local | awk '
  BEGIN {
    count = split("OPENAI_API_KEY DATABASE_URL DATABASE_URL_UNPOOLED NEON_BRANCH NEON_BRANCH_ID NEON_FUNCTION_HOST_SUFFIX", keys)
    for (i = 1; i <= count; i++) { expected["# " keys[i] "="] = 1 }
  }
  /^[[:space:]]*$/ { next }
  $0 == "# Copy this file to .env. Uncomment the settings you use and fill in their values there." { next }
  $0 == "# OpenAI API key for scheduling chat." { next }
  $0 == "# Pooled Neon connection string for the running app." { next }
  $0 == "# Direct Neon connection string for migrations and seeding. The seed falls back to DATABASE_URL." { next }
  $0 == "# Neon branch name and ID." { next }
  $0 == "# Hostname suffix for Neon Functions." { next }
  $0 in expected { seen[$0]++; next }
  { invalid = 1 }
  END {
    for (line in expected) { if (seen[line] != 1) { invalid = 1 } }
    exit invalid
  }
'; then
  echo "Stage only the documented comments and six blank, commented settings in .env.local." >&2
  exit 1
fi

# All inputs must match the index before checking the working tree.
set -- src tsconfig.json .dependency-cruiser.json package.json bun.lock .githooks/pre-commit
if ! git diff --quiet -- "$@" || [ -n "$(git ls-files --others --exclude-standard -- "$@")" ]; then
  echo "Module boundary inputs have unstaged changes. Stage or set aside those edits first." >&2
  exit 1
fi
exec bun run boundaries

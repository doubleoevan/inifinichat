{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "react", "react-dom"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "tests", "evals", "neon.ts"]
}
